# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/.pub-cache/
app/.pub/
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/.symlinks/

# Client-side secrets (copy the *.example templates and fill in)
app/android/secrets.properties
app/ios/Flutter/Secrets.xcconfig

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Backend runtime
backend/.env
backend/*.db
backend/data/*.db

# Vercel (deploy config is committed; local link state and the pre-built
# Flutter bundle in public/ are not)
.vercel/
public/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs & temp
*.log
.cache/

# Vercel CLI local state + the .env.local it writes (contains an OIDC token)
.env*
