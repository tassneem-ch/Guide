# ---------------------------------------------------------------------------
# Guide backend — environment template. Copy to `.env` and fill in.
# NEVER commit real keys. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development                 # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./guide.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/guide
# PostgreSQL + PostGIS (enables geospatial queries):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/guide
# POSTGIS_ENABLED=true

# --- Auth (optional) ---
AUTH_REQUIRED=false                # true => JWT required for saved trips/preferences
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=10080

# --- Provider selection (see docs/PROVIDERS.md) ---
# prayer:   aladhan (default, keyless) | fixture
# routing:  google (key required) | osrm (keyless, dev) | fixture
# mosques:  google (key required) | osm (keyless, dev) | fixture
# geocoding: google (key required) | nominatim (keyless, dev) | fixture
# places:    auto (Google Places API (New) when a key is set, keyless
#            geocoding suggestions otherwise) | google | nominatim
PRAYER_PROVIDER=aladhan
ROUTING_PROVIDER=osrm
MOSQUE_PROVIDER=osm
GEOCODING_PROVIDER=nominatim
PLACES_PROVIDER=auto
OPTIMIZATION_PROVIDER=internal      # internal (default solver) | google

# --- Provider credentials (server-side only, never shipped to the app) ---
GOOGLE_MAPS_API_KEY=                # Routes API + Places API (New) + Geocoding API
GOOGLE_ROUTE_OPTIMIZATION_KEY=      # separate key for Route Optimization API
ALADHAN_API_BASE=https://api.aladhan.com/v1
OSRM_API_BASE=https://router.project-osrm.org
OVERPASS_API_BASE=https://overpass-api.de/api/interpreter
# Optional: JSON list of backup Overpass instances, tried when the
# primary fails or answers empty while overloaded.
# OVERPASS_FALLBACKS=["https://overpass.kumi.systems/api/interpreter","https://maps.mail.ru/osm/tools/overpass/api/interpreter"]
NOMINATIM_API_BASE=https://nominatim.openstreetmap.org

# --- Engine tuning ---
ROUTE_CACHE_TTL_SECONDS=900         # route/matrix cache (where provider terms allow)
PRAYER_CACHE_TTL_SECONDS=21600
MAX_MATRIX_ELEMENTS=300             # per-request routing-matrix budget
DEFAULT_MAX_DETOUR_MIN=25
DEFAULT_STOP_DURATION_MIN=15
DEFAULT_PLANNING_WINDOW_MIN=30      # arrive this early and wait
DEFAULT_PRAYER_BUFFER_MIN=10        # latest acceptable arrival after prayer start

# --- Community mosque submissions (secondary source, see docs/PROVIDERS.md) ---
COMMUNITY_MOSQUES_ENABLED=true              # master switch for the +community layer
COMMUNITY_INCLUDE_UNVERIFIED=false          # opt-in: include unverified submissions
                                            # in discovery (still labelled unverified)
COMMUNITY_REPORT_THRESHOLD=3                # reports before a verified record is
                                            # demoted back to unverified
ADMIN_TOKEN=                                # moderation secret for
                                            # PATCH /v1/community/mosques/{id}/review
                                            # (X-Admin-Token header); empty = disabled

# --- Security / limits ---
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Logging ---
LOG_LEVEL=INFO
